{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": false,
    "sourceMap": true,
    "typeRoots": ["types", "node_modules/@types"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.ts"]
}